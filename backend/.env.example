# Postgres / PostGIS — used by `docker compose up` and in production.
#DATABASE_URL=postgresql+psycopg2://connx:connx@localhost:5432/connx

# For local dev WITHOUT Docker/Postgres, comment the line above and
# uncomment this instead — no spatial DB features are actually used by
# the app (overlap/red-spot math runs in Python via Shapely), so SQLite
# is a fully working, zero-setup substitute for day-to-day dev:
DATABASE_URL=sqlite:///./connx_dev.db

# Routing provider: "osrm" (free public demo, driving/cycling/walking) or "mock" (offline, for dev/tests)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding provider: "photon" (fast type-ahead search, falls back to Nominatim on
# timeout/error; Nominatim always does reverse geocoding), "nominatim" only, or "mock"
GEOCODING_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_TIMEOUT_S=3
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOTE: must be a real, non-placeholder contact - OSM blocklists
# example.com-style placeholders with HTTP 403.
NOMINATIM_USER_AGENT=ConnX/0.1 (contact: your-real-email@yourdomain.com)

# Environment: "development" (CORS accepts any localhost/127.0.0.1 port —
# no need to match your teammates' ports) or "production" (CORS locks to
# FRONTEND_ORIGIN below, exact match only)
ENVIRONMENT=development

# CORS — only used when ENVIRONMENT=production
FRONTEND_ORIGIN=http://localhost:3000

# Anonymous session cookie (no accounts, per privacy-first spec)
SESSION_SECRET=change-me-in-production



