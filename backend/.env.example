# Postgres / PostGIS
DATABASE_URL=postgresql+psycopg2://connx:connx@localhost:5432/connx

# Routing provider: "osrm" (free public demo, driving/cycling/walking) or "mock" (offline, for dev/tests)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding provider: "nominatim" (OpenStreetMap, free) or "mock"
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ConnX/0.1 (contact: you@example.com)

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Anonymous session cookie (no accounts, per privacy-first spec)
SESSION_SECRET=change-me-in-production
