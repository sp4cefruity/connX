NEXT_PUBLIC_API_URL=http://localhost:8000

# Basemap style (MapLibre style JSON URL). Defaults to the OpenFreeMap dark
# style, which needs no API key. Any MapLibre-compatible vector style works;
# palette tuning in MapView.tsx is skipped for layer ids the style lacks.
# Alternatives: https://tiles.openfreemap.org/styles/liberty (light)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
